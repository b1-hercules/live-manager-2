<% layout('layouts/main') %>

<div class="card mb-2">
  <div class="card-head">
    <h2>Unggah Video</h2>
    <span class="sub">maks <%= maxUploadMb %> MB · mp4, mkv, mov, flv, webm, ts</span>
  </div>
  <div class="card-body">
    <form method="post" action="/videos/upload" enctype="multipart/form-data" id="uploadForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="field">
          <label for="video">File Video</label>
          <input id="video" name="video" type="file" accept="video/*,.mkv,.ts,.flv" required>
        </div>
        <div class="field">
          <label for="title">Judul <span class="text-mute">(opsional)</span></label>
          <input id="title" name="title" type="text" placeholder="Otomatis dari nama file">
        </div>
      </div>
      <div class="btn-row">
        <button class="btn btn-primary" type="submit" id="uploadBtn">
          <%- include('../partials/icon', { name: 'upload' }) %> Unggah
        </button>
        <button class="btn btn-ghost btn-sm" type="button" id="uploadCancel" hidden>Batal</button>
        <button class="btn btn-sm" type="button" id="driveBtn">
          <%- include('../partials/icon', { name: 'link' }) %> Impor dari Drive
        </button>
        <span class="text-xs text-mute" id="uploadNote">
          Video akan diprobe dengan ffprobe dan dibuatkan thumbnail otomatis.
        </span>
      </div>
      <div id="uploadProgress" class="mt-1" hidden>
        <div class="meter ok"><span id="uploadBar" style="width:0%"></span></div>
      </div>
      <div id="importJobs" class="mt-1"></div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-head">
    <h2>Galeri <span class="sub">· <%= videos.length %> video · <%= formatBytes(totalSize) %></span></h2>
    <form method="get" action="/videos" class="flex gap-1">
      <input type="search" name="q" value="<%= search %>" placeholder="Cari judul..." style="width:200px">
      <button class="btn btn-sm" type="submit">Cari</button>
      <% if (search) { %><a href="/videos" class="btn btn-ghost btn-sm">Reset</a><% } %>
    </form>
  </div>

  <% if (!videos.length) { %>
    <div class="empty">
      <div class="empty-icon"><%- include('../partials/icon', { name: 'video' }) %></div>
      <h3><%= search ? 'Tidak ada yang cocok' : 'Galeri masih kosong' %></h3>
      <p><%= search ? 'Coba kata kunci lain.' : 'Unggah video pertama kamu di form di atas. Video inilah yang akan diputar berulang sebagai siaran live.' %></p>
    </div>
  <% } else { %>
    <div class="card-body">
      <div class="grid grid-4">
        <% videos.forEach(function (v) { %>
          <div class="video-card">
            <button type="button" class="thumb-preview"
                    data-preview-src="<%= mediaUrl(v.filepath) %>"
                    data-preview-title="<%= v.title %>"
                    title="Putar pratinjau">
              <% if (v.thumbnail_path) { %>
                <img class="thumb thumb-lg" src="<%= mediaUrl(v.thumbnail_path) %>" alt="" loading="lazy">
              <% } else { %>
                <div class="thumb thumb-lg thumb-ph">tanpa thumbnail</div>
              <% } %>
              <span class="play-badge"><%- include('../partials/icon', { name: 'play' }) %></span>
            </button>
            <div class="meta">
              <h3 title="<%= v.title %>"><%= v.title %></h3>
              <div class="specs">
                <span><%= v.width %>×<%= v.height %></span>
                <span><%= formatDuration(v.duration) %></span>
                <span><%= formatBytes(v.filesize) %></span>
              </div>
              <div class="specs" style="padding-top:4px">
                <span class="badge badge-muted"><%= (v.video_codec || '?').toUpperCase() %></span>
                <% if (v.has_audio) { %>
                  <span class="badge badge-muted"><%= (v.audio_codec || '?').toUpperCase() %></span>
                <% } else { %>
                  <span class="badge badge-warn">tanpa audio</span>
                <% } %>
                <% if (v.fps) { %><span class="badge badge-muted"><%= Math.round(v.fps) %>fps</span><% } %>
              </div>
            </div>
            <div class="card-foot" style="padding:9px 12px">
              <details class="collapse" style="flex:1;border:0;background:none">
                <summary style="padding:0;font-size:12px">Ubah judul</summary>
                <div class="collapse-body" style="padding:10px 0 0;border:0">
                  <form method="post" action="/videos/<%= v.id %>/rename" class="flex gap-1">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="text" name="title" value="<%= v.title %>" required>
                    <button class="btn btn-sm btn-primary" type="submit">OK</button>
                  </form>
                </div>
              </details>
              <form method="post" action="/videos/<%= v.id %>/delete"
                    data-confirm="Hapus &quot;<%= v.title %>&quot;? File di disk ikut terhapus permanen.">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-danger" type="submit" title="Hapus video">
                  <%- include('../partials/icon', { name: 'trash' }) %>
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<div id="driveModal" class="modal-backdrop" hidden>
  <div class="modal-box" role="dialog" aria-modal="true" aria-label="Impor dari Google Drive">
    <div class="modal-head">
      <strong>Impor dari Google Drive</strong>
      <button type="button" class="btn btn-sm btn-ghost" id="driveClose">Tutup</button>
    </div>
    <div class="modal-body">
      <form class="flex gap-1 mb-2" id="driveSearchForm">
        <input type="search" id="driveSearch" placeholder="Cari nama video di Drive..." style="flex:1">
        <button class="btn btn-sm" type="submit">Cari</button>
      </form>
      <div id="driveList"></div>
    </div>
  </div>
</div>

<script>
  (function () {
    const form = document.getElementById('uploadForm');
    const input = document.getElementById('video');
    const btn = document.getElementById('uploadBtn');
    const note = document.getElementById('uploadNote');
    const cancelBtn = document.getElementById('uploadCancel');
    const progress = document.getElementById('uploadProgress');
    const bar = document.getElementById('uploadBar');
    if (!form) return;

    // Tanpa File.slice (browser sangat lawas) formulir dibiarkan mengirim
    // multipart biasa seperti sebelumnya — masih jalan, hanya tidak bisa disambung.
    const canChunk = window.LM && window.File && File.prototype.slice;
    if (!canChunk) {
      form.addEventListener('submit', function () {
        btn.disabled = true;
        btn.textContent = 'Mengunggah...';
        note.textContent = 'Jangan tutup halaman ini. File besar bisa memakan beberapa menit.';
      });
      return;
    }

    let job = null;

    form.addEventListener('submit', function (e) {
      const file = input.files && input.files[0];
      if (!file) return;
      e.preventDefault();

      btn.disabled = true;
      btn.textContent = 'Mengunggah...';
      progress.hidden = false;
      cancelBtn.hidden = false;

      job = LM.resumableUpload(file, {
        title: form.title.value,
        onProgress: function (sent, total) {
          const pct = total ? Math.round((sent / total) * 100) : 0;
          bar.style.width = pct + '%';
          note.textContent = pct + '% terkirim. Koneksi putus tidak masalah — '
            + 'unggahan disambung dari posisi terakhir.';
        },
      });

      job.promise.then(function () {
        note.textContent = 'Selesai, memuat ulang galeri...';
        window.location.href = '/videos';
      }).catch(function (err) {
        job = null;
        btn.disabled = false;
        btn.innerHTML = 'Unggah';
        cancelBtn.hidden = true;
        note.textContent = '';
        LM.toast(err.message, 'error');
      });
    });

    cancelBtn.addEventListener('click', function () {
      if (job) job.cancel();
      job = null;
      progress.hidden = true;
      cancelBtn.hidden = true;
      bar.style.width = '0%';
      btn.disabled = false;
      btn.innerHTML = 'Unggah';
      note.textContent = 'Unggahan dibatalkan.';
    });

    // Menutup tab di tengah unggahan tidak menghanguskan kemajuan: id-nya
    // tersimpan, jadi memilih berkas yang sama lagi akan menyambung sendiri.
    window.addEventListener('beforeunload', function (e) {
      if (!job) return;
      e.preventDefault();
      e.returnValue = '';
    });
  })();

  // --------------------------------------------- impor dari Google Drive
  (function () {
    const openBtn = document.getElementById('driveBtn');
    const modal = document.getElementById('driveModal');
    const closeBtn = document.getElementById('driveClose');
    const searchForm = document.getElementById('driveSearchForm');
    const searchInput = document.getElementById('driveSearch');
    const list = document.getElementById('driveList');
    const jobsBox = document.getElementById('importJobs');
    if (!openBtn || !window.LM) return;

    function fmtSize(bytes) {
      if (!bytes) return '';
      const units = ['KB', 'MB', 'GB', 'TB'];
      let value = bytes / 1024;
      let i = 0;
      while (value >= 1024 && i < units.length - 1) { value /= 1024; i++; }
      return value.toFixed(value >= 10 ? 0 : 1) + ' ' + units[i];
    }

    function message(text) {
      list.textContent = '';
      const p = document.createElement('p');
      p.className = 'text-sm text-mute mb-0';
      p.textContent = text;
      list.appendChild(p);
    }

    function render(files) {
      list.textContent = '';
      if (!files.length) return message('Tidak ada video yang cocok di Drive.');

      files.forEach(function (file) {
        const row = document.createElement('div');
        row.className = 'drive-row';

        const body = document.createElement('div');
        body.className = 'body';
        const name = document.createElement('div');
        name.className = 't';
        name.textContent = file.name;
        const detail = document.createElement('div');
        detail.className = 'd';
        detail.textContent = [
          fmtSize(file.size),
          file.duration ? Math.round(file.duration) + ' detik' : '',
          file.width ? file.width + '×' + file.height : '',
        ].filter(Boolean).join(' · ');
        body.append(name, detail);

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'btn btn-sm btn-primary';
        btn.textContent = 'Impor';
        btn.addEventListener('click', function () {
          btn.disabled = true;
          btn.textContent = 'Memulai...';
          LM.post('/videos/import/drive', { fileId: file.id }).then(function () {
            LM.toast('Impor "' + file.name + '" dimulai. Boleh tutup jendela ini.', 'success');
            close();
            track();
          }).catch(function (err) {
            btn.disabled = false;
            btn.textContent = 'Impor';
            LM.toast(err.message, 'error');
          });
        });

        row.append(body, btn);
        list.appendChild(row);
      });
    }

    function load(query) {
      message('Memuat daftar video dari Drive...');
      LM.get('/videos/import/drive/files?q=' + encodeURIComponent(query || ''))
        .then(function (data) { render(data.files); })
        .catch(function (err) { message(err.message); });
    }

    function open() { modal.hidden = false; load(searchInput.value); }
    function close() { modal.hidden = true; }

    openBtn.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    modal.addEventListener('click', function (e) { if (e.target === modal) close(); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !modal.hidden) close(); });
    searchForm.addEventListener('submit', function (e) { e.preventDefault(); load(searchInput.value); });

    // ---------------------------------------- kemajuan impor yang berjalan
    let poller = null;

    function renderJobs(jobs) {
      jobsBox.textContent = '';
      jobs.forEach(function (job) {
        const pct = job.total ? Math.round((job.received / job.total) * 100) : 0;
        const wrap = document.createElement('div');
        wrap.className = 'mt-1';

        const label = document.createElement('div');
        label.className = 'text-xs text-mute';
        if (job.state === 'error') label.textContent = 'Impor "' + job.name + '" gagal: ' + job.error;
        else if (job.state === 'done') label.textContent = 'Impor "' + job.name + '" selesai.';
        else if (job.state === 'processing') label.textContent = 'Memproses "' + job.name + '" (ffprobe & thumbnail)...';
        else label.textContent = 'Mengunduh "' + job.name + '" — ' + pct + '%';
        wrap.appendChild(label);

        if (job.state === 'downloading') {
          const meter = document.createElement('div');
          meter.className = 'meter ok mt-1';
          const fill = document.createElement('span');
          fill.style.width = pct + '%';
          meter.appendChild(fill);
          wrap.appendChild(meter);
        }
        jobsBox.appendChild(wrap);
      });
    }

    function track() {
      if (poller) return;
      poller = LM.poll('/videos/import/jobs', 2000, function (data) {
        renderJobs(data.jobs);
        const busy = data.jobs.some(function (j) { return j.state === 'downloading' || j.state === 'processing'; });
        const done = data.jobs.some(function (j) { return j.state === 'done'; });
        if (busy) return;
        poller.stop();
        poller = null;
        // Galeri dimuat ulang hanya kalau tidak ada impor lain yang berjalan,
        // supaya kemajuan yang sedang tampil tidak terputus di tengah jalan.
        if (done) setTimeout(function () { window.location.href = '/videos'; }, 1200);
      });
    }

    // Impor yang masih berjalan dari kunjungan sebelumnya tetap terlihat.
    LM.get('/videos/import/jobs').then(function (data) {
      if (data.jobs.length) { renderJobs(data.jobs); track(); }
    }).catch(function () { /* tidak penting kalau gagal */ });
  })();
</script>
