# ============ SERVER ============
PORT=7575
HOST=0.0.0.0
NODE_ENV=production

# URL publik aplikasi. WAJIB benar untuk OAuth callback YouTube.
# Contoh: http://localhost:7575  atau  https://live.domainkamu.com
APP_URL=http://localhost:7575

# ============ KEAMANAN ============
# Generate dengan: npm run generate-secret
SESSION_SECRET=ganti-dengan-string-acak-64-karakter
# Kunci enkripsi token OAuth (32 byte hex). Generate: npm run generate-secret
ENCRYPTION_KEY=ganti-dengan-hex-64-karakter

# ============ FFMPEG ============
# Kosongkan untuk auto-detect dari PATH
FFMPEG_PATH=
FFPROBE_PATH=

# ============ UPLOAD ============
# Batas ukuran video dalam MB. Berlaku untuk ketiga jalur masuk: unggah biasa,
# unggah berpotongan (resumable), dan impor dari Google Drive.
MAX_UPLOAD_MB=4096
# Batas ukuran thumbnail dalam MB (YouTube maksimal 2MB)
MAX_THUMB_MB=2

# ============ GOOGLE / YOUTUBE ============
# Client ID & Secret TIDAK diisi di sini — masukkan lewat halaman Pengaturan,
# supaya tersimpan terenkripsi di database. Izin yang diminta mencakup
# drive.readonly untuk impor video dari Google Drive; akun yang dihubungkan
# sebelum fitur itu ada harus dihubungkan ulang.

# ============ ZONA WAKTU ============
TZ=Asia/Jakarta
